@startuml
' Nickhil contribution D2: current whole-file Task and parser allocation.
!pragma layout smetana
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 15
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam ArrowColor #475569
skinparam classBorderColor #475569
skinparam packageBorderColor #94A3B8
hide empty members
top to bottom direction

package "scheduleflow.cli" {
    class CommandParser {
        +parse(line: String): Command
        -parseTaskProgress(input: String): Command
    }
    class ParseException {
        +usage(): String
    }
    interface "Command\nexternal: Ka How" as Command #F1F5F9
}

package "scheduleflow.task" {
    class TaskService {
        +recordWork(...): Snapshot
        +recordSessionProgress(...): Snapshot
        +complete(...): Snapshot
        +reopen(...): Snapshot
        -replaceRemaining(...): Snapshot
    }
    class TaskEdit <<record>> {
        name: Optional<String>
        deadline: Optional<LocalDateTime>
        clearDeadline: boolean
    }
}

package "scheduleflow.model" {
    class Task <<record>> {
        id: int
        name: String
        deadline: Optional<LocalDateTime>
        remainingMinutes: int
        +displayId(): String
    }
    enum TaskPriority {
        HIGH
        NORMAL
        LOW
    }
    class "TaskOccurrence\nexternal: Gabriel" as TaskOccurrence #F1F5F9
    class "Snapshot\nexternal: Ernest" as Snapshot #F1F5F9 {
        +withTasks(replacements, nextId): Snapshot
    }
}

package "scheduleflow.common" {
    class InputRules {
        {static} +normalizeName(value): String
        {static} +requireTaskMinutes(minutes): void
    }
    class ValidationException
}

CommandParser ..> Command : creates / returns
CommandParser ..> ParseException : throws
CommandParser ..> TaskEdit : creates for edits
TaskService ..> TaskEdit : reads
TaskService ..> Task : creates replacements
TaskService ..> Snapshot : reads / returns candidate
Task --> "1" TaskPriority : priority
Task --> "0..1" TaskOccurrence : occurrence
Task ..> InputRules : validates structure
InputRules ..> ValidationException : rejects invalid values

' Layout-only edge; this is not a parser-to-service call or UML relationship.
CommandParser -[hidden]down-> TaskService
@enduml
