@startuml
!include course-style.puml
left to right direction
hide empty members

class Main SHELL {
    {static} + main(args: String[]) : void
}
class App SHELL {
    + run() : int
    - runCommands(state: AppState) : int
    - writeResponse(text: String) : boolean
}
class ConsoleUi SHELL {
    + prompt() : void
    + readLine() : String
    + write(text: String) : void
    - flushOutput() : void
}
class BufferedReader <<java.io>> VALUES
class PrintWriter <<java.io>> VALUES {
    + checkError() : boolean
}
class TextRenderer SHELL {
    + help() : String
    + parseError(exception: ParseException) : String
    + error(message: String) : String
}
class AppState SHELL {
    + commit(saved: Snapshot) : void
    + replacePlan(plan: Plan) : void
}
interface Command <<interface>> SHELL
class "Command.Help" as Help <<record>> SHELL
class "Command.AddTask" as AddTask <<record>> SHELL
class CommandResponse <<record>> SHELL {
    - output: String
    - shouldExit: boolean
}
class CommandParser PARSING {
    + parse(line: String) : Command
}
class CommandDispatcher DOMAIN {
    + execute(command: Command, state: AppState) : CommandResponse
}
interface Storage <<interface>> PERSISTENCE
class Snapshot <<record>> VALUES
class Plan <<record>> VALUES

Main ..> App : creates
App --> "ui\n1" ConsoleUi
App --> "renderer\n1" TextRenderer
App --> "parser\n1" CommandParser
App --> "dispatcher\n1" CommandDispatcher
App --> "storage\n1" Storage
ConsoleUi --> "input\n1" BufferedReader
ConsoleUi --> "output\n1" PrintWriter
App ..> AppState : creates in run()
Command <|.. Help
Command <|.. AddTask
AppState --> "snapshot\n1" Snapshot
AppState --> "currentPlan\n0..1" Plan

note as CommandNote
  Only two representative command records are shown.
end note
CommandNote -[dotted]-> Command

note as OutputNote
  checkError() flushes and checks output.
  ConsoleUi exposes writer failure as UncheckedIOException.
  App stops with status 1 without another command read.
end note
OutputNote -[dotted]-> ConsoleUi
@enduml
