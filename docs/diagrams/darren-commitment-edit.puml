@startuml
!include course-style.puml

participant "app:App" as App SHELL
participant "dispatcher:CommandDispatcher" as Dispatcher DOMAIN
participant "commitments:CommitmentService" as Service DOMAIN
participant "storage:FileStorage" as Storage PERSISTENCE
participant "state:AppState" as State SHELL
participant "renderer:TextRenderer" as Renderer SHELL

App -> Dispatcher ++ : execute(command: EditCommitment, state)
note right of Dispatcher : Capture now once; time API and accessors omitted.
Dispatcher -> Dispatcher ++ : editCommitment(command, state)
Dispatcher -> State ++ : snapshot()
State --> Dispatcher -- : source
Dispatcher -> Service ++ : edit(source, id, name, day, start,\nminutes, startDate, endDate)
Service -> Service ++ : createEdit(source, id, name, day, start,\nminutes, startDate, endDate)
note right of Service
  Find original; resolve omitted fields.
  Construct and validate the replacement Commitment.
  Record creation and source accessors are omitted.
end note
Service -> Service ++ : rejectOverlaps(edited, otherCommitments)
Service --> Service -- : return
note right of Service
  Replace C1 at the same list position.
  withCommitments creates the candidate (call omitted).
end note
Service --> Service -- : candidate
Service --> Dispatcher -- : candidate
Dispatcher -> Dispatcher ++ : saveAndCommit(candidate, state)
note right of Dispatcher : Original snapshot/plan accessors and assertions omitted.
Dispatcher -> Storage ++ : save(candidate)
Storage --> Dispatcher -- : return (atomic replacement succeeded)
Dispatcher -> State ++ : commit(candidate)
note right of State : Publish saved candidate and clear currentPlan.
State --> Dispatcher -- : return
Dispatcher --> Dispatcher -- : return
Dispatcher -> Renderer ++ : commitmentEdited(edited)
Renderer --> Dispatcher -- : confirmation
Dispatcher --> Dispatcher -- : confirmation
Dispatcher --> App -- : response: CommandResponse
@enduml
