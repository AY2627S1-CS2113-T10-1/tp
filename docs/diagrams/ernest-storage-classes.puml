@startuml
!include course-style.puml
left to right direction
hide empty members

interface Storage <<interface>> PERSISTENCE {
    + load() : Snapshot
    + loadPlan(source: Snapshot) : Optional<Plan>
    + save(state: Snapshot) : void
    + savePlan(plan: Plan) : void
}
class FileStorage PERSISTENCE {
    - file: Path
    - writeAtomically(text: String) : void
    - removeTemporaryFile(temporaryFile: Path, failure: StorageException) : void
}
class StateCodec PERSISTENCE {
    + encode(state: Snapshot) : String
    + decode(text: String) : Snapshot
    ~ encodeForPlan(state: Snapshot) : String
}
class "~PlanCodec" as PlanCodec PERSISTENCE {
    ~ PlanCodec(snapshots: StateCodec)
    ~ encode(plan: Plan) : String
    ~ decode(text: String) : Plan
}
class StorageException PARSING
class Snapshot <<record>> VALUES {
    - tasks: List<Task>
    - commitments: List<Commitment>
    - recurringTasks: List<RecurringTask>
}
class Plan <<record>> VALUES

Storage <|.. FileStorage
FileStorage --> "codec\n1" StateCodec
FileStorage ..> PlanCodec : creates
PlanCodec --> "snapshots\n1" StateCodec
StateCodec ..> PlanCodec : decodes plan sources
StateCodec ..> Snapshot : creates
PlanCodec ..> Plan : creates / reads
FileStorage ..> StorageException : throws
Plan --> "source\n1" Snapshot

note as SnapshotNote
  Hours, policy and three ID counters are omitted.
  Lists are copied; counters survive deletion.
end note
SnapshotNote -[dotted]-> Snapshot
@enduml
